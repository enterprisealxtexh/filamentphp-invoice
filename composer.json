{
    "name": "alxtexh/filament-invoices",
    "type": "library",
    "description": "Generate and manage invoices and receipts with multi-currency support, PDF export, and email integration for Filament v5",
    "keywords": [
        "php",
        "laravel",
        "invoices",
        "receipts",
        "payments",
        "filament",
        "filament-plugin",
        "filament-v5"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Alxtexh\\FilamentInvoices\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alxtexh\\FilamentInvoices\\FilamentInvoicesServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Alxtexh",
            "email": "alxtexh@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "spatie/laravel-settings": "^3.0||^4.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
